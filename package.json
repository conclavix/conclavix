{
  "name": "conclavix-monorepo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && pnpm test:review && pnpm test:fixer && pnpm test:sandbox",
    "test:review": "node --test \".github/review/test/*.test.mjs\"",
    "test:fixer": "node --test \".github/fixer/test/*.test.mjs\"",
    "smoke": "scripts/smoke-start.sh",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm smoke && pnpm typecheck && pnpm test",
    "test:sandbox": "node --test \"deploy/agent-sandbox/test/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
