# Runner only. Install as /etc/conclavix/runner.env, mode 0600 root:root.
# MongoDB and Redis are reached through the ports compose publishes on 127.0.0.1.
# Same users and passwords as in conclavix.env.
MONGO_URI=mongodb://conclavix:<MONGO_APP_PASSWORD>@127.0.0.1:27017/conclavix?replicaSet=rs0&directConnection=true
REDIS_URL=redis://conclavix:<REDIS_PASSWORD>@127.0.0.1:6379
PUBLIC_API_URL=http://127.0.0.1:3300
WORKSPACES_ROOT=/srv/conclavix/workspaces
CLAUDE_BIN=/usr/bin/claude
# Agents run as this user through sudo (see deploy/sudoers/conclavix-runner); it must not be the
# runner user. Unset, agents run as the runner and can read its secrets.
AGENT_USER=cvx-agent
# SUDO_BIN=/usr/bin/sudo
RUNNER_CONCURRENCY=2
# After a reboot the compose services may still be starting; the runner retries them this long.
STARTUP_WAIT_SECONDS=120
# How the claude CLI reaches the model, for example through an LLM gateway:
# ANTHROPIC_BASE_URL=http://127.0.0.1:4000
# Per-agent gateway keys. An agent with adapter.gatewayKeySecret "CEO" uses CVX_SECRET_CEO;
# agents without one use ANTHROPIC_CUSTOM_HEADERS above. Only CVX_SECRET_* can be referenced.
# CVX_SECRET_CEO=sk-...
# Coding agents (docs/coding-agents.md). Unset: agents with code access 'write' fail their runs.
# AGENT_SANDBOX_HELPER=/usr/local/libexec/conclavix/agent-run.mjs
# Project repositories and issue clones, the same directory the API mounts (docs/workspace.md).
# WORKSPACE_ROOT=/srv/conclavix/code
# Limits per coding run (the helper refuses more than its configured maxima).
# CODE_RUN_MEMORY_MAX=4G
# CODE_RUN_CPU_QUOTA=200
# CODE_RUN_TASKS_MAX=512
# CODE_RUN_DISK_LIMIT_MB=4096
# Hosts sandboxed commands may reach besides npm and PyPI, comma-separated.
# CODE_SANDBOX_DOMAINS=registry.yarnpkg.com
