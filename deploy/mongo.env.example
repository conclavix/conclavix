# MongoDB container only (docker compose). Copy to mongo.env, chmod 600.
# Users are created from these values on the first start with an empty volume.
MONGO_INITDB_ROOT_USERNAME=root
# openssl rand -hex 32
MONGO_INITDB_ROOT_PASSWORD=
# The application user; MONGO_URI in conclavix.env and runner.env uses the same password.
MONGO_APP_USERNAME=conclavix
# openssl rand -hex 32
MONGO_APP_PASSWORD=
# Replica set key, required with authentication: openssl rand -base64 756 | tr -d '\n'
MONGO_KEYFILE=
