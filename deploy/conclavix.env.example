# Shared by api and scheduler (docker compose) and the runner (systemd).
# Signs board sessions and encrypts stored secrets. At least 32 characters: openssl rand -hex 32
AUTH_SECRET=
# Public URL of the board as browsers open it (cookies, reset links, allowed origin).
# Cookies are marked Secure when it starts with https. Defaults to PUBLIC_API_URL.
# BOARD_URL=https://conclavix.example.com
# SESSION_TTL_HOURS=168
# MFA_POLICY=required_for_admins   # optional | required | required_for_admins
# INSTANCE_NAME=Conclavix
# Mail for password resets and invitations; admins can override it in the settings.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Conclavix <conclavix@example.com>
# Deprecated break-glass owner credential; remove once scripts use personal API tokens.
# At least 32 characters: openssl rand -hex 32
# BOARD_TOKEN=
# MongoDB and Redis as the api and scheduler containers reach them. The passwords are
# MONGO_APP_PASSWORD from mongo.env and REDIS_PASSWORD from redis.env (hex, so no URL escaping).
MONGO_URI=mongodb://conclavix:<MONGO_APP_PASSWORD>@mongo:27017/conclavix?replicaSet=rs0
REDIS_URL=redis://conclavix:<REDIS_PASSWORD>@redis:6379
LOG_LEVEL=info
RUN_TIMEOUT_MINUTES=30
HEARTBEAT_MINUTES=60
# Wait before an agent's next run on an issue after maxIdleRunsPerIssue runs without progress.
IDLE_BACKOFF_MINUTES=10
# Model names the board suggests when creating or editing an agent (comma-separated, free text
# stays possible; default opus,sonnet,haiku). With a LiteLLM gateway, use its model names.
# Admins can override the list in the instance settings.
# CONCLAVIX_MODELS=claude-opus-5-5,claude-sonnet-5,claude-haiku-4-5
# Skill directories may only use public https endpoints. true also allows http and private
# addresses; only for local tests against a mock directory, never in production.
# SKILL_SOURCES_ALLOW_PRIVATE=false
# Memory: builtin (MongoDB) or hindsight (see hindsight.env.example and the hindsight profile).
MEMORY_BACKEND=builtin
# HINDSIGHT_URL=http://hindsight:8888
# HINDSIGHT_BANK=conclavix
