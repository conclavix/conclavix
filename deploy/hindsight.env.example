# Only needed with MEMORY_BACKEND=hindsight (docker compose --profile hindsight up -d).
# Hindsight extracts facts with an LLM on every save. Any OpenAI-compatible endpoint works,
# for example an LLM gateway. Free tiers rate-limit quickly; saves then fail with 503.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=
HINDSIGHT_API_LLM_MODEL=
HINDSIGHT_API_LLM_API_KEY=
