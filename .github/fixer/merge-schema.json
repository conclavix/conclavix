{
  "type": "object",
  "additionalProperties": false,
  "required": ["files", "extra_edits", "summary"],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "decision", "resolution", "reasoning"],
        "properties": {
          "path": { "type": "string" },
          "decision": { "type": "string", "enum": ["resolved", "needs_human"] },
          "resolution": { "type": "string" },
          "reasoning": { "type": "string" }
        }
      }
    },
    "extra_edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
