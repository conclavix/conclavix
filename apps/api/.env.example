NODE_ENV=development
HOST=127.0.0.1
PORT=3300
LOG_LEVEL=info
# Must be a replica set (a single node is enough); transactions are required.
MONGO_URI=mongodb://127.0.0.1:27017/conclavix?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
# At least 32 characters. Generate one with: openssl rand -hex 32
AUTH_SECRET=
# Board URL as the browser sees it (Vite dev server); defaults to PUBLIC_API_URL.
BOARD_URL=http://localhost:5173
MFA_POLICY=required_for_admins
# Deprecated: optional break-glass owner token for scripts (at least 32 characters).
# BOARD_TOKEN=

# Agent API URL as the runner hands it to agents (they call <PUBLIC_API_URL>/mcp).
PUBLIC_API_URL=http://127.0.0.1:3300
WORKSPACES_ROOT=/srv/conclavix/workspaces
# Project git repositories and issue clones, written by the API (docs/workspace.md).
WORKSPACE_ROOT=./data/workspace
# GIT_BIN=git
# Domain of the no-reply addresses agent commits and merges carry (agent-<id>@<domain>);
# set the same value for the API and the runner.
# AGENT_EMAIL_DOMAIN=conclavix.invalid
CLAUDE_BIN=claude
RUNNER_CONCURRENCY=2
RUN_TIMEOUT_MINUTES=30
SCHEDULER_TICK_MS=2000
HEARTBEAT_MINUTES=60
# Wait before an agent's next run on an issue after maxIdleRunsPerIssue runs without progress.
IDLE_BACKOFF_MINUTES=10
# Hard cap on runs of one agent on one issue in 24 hours, progress or not (loop backstop).
MAX_RUNS_PER_ISSUE_PER_DAY=50
# Comma-separated model suggestions for the board's agent forms; empty means none.
CONCLAVIX_MODELS=
# How long the runner retries MongoDB and Redis at startup before it gives up (0 = one attempt).
STARTUP_WAIT_SECONDS=120
